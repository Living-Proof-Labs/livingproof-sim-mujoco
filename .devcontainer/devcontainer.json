{
  "name": "MuJoCo development",
  "dockerComposeFile": "../compose.yaml",
  "service": "tooling",
  "workspaceFolder": "/workspace/mujoco",
  "remoteUser": "vscode",
  "overrideCommand": true,
  "postCreateCommand": "task setup",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "MuJoCo rendered playback",
      "onAutoForward": "notify"
    }
  }
}
